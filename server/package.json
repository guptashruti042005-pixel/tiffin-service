{
  "name": "server",
  "version": "1.0.0",
  "description": "Backend server for TiffinTrack",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test --test-concurrency=1 src/tests/unit/*.test.js src/tests/integration/*.test.js",
    "test:unit": "node --test src/tests/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 src/tests/integration/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^9.10.1"
  }
}
